# backend/.env — config.py 가 읽는 런타임 환경변수 (v2 — WebRTC).
# 실제 값은 backend/.env 에만 (git 에 안 올림). 이 파일은 placeholder + 설명만.

# 허용 오리진 (CORS). 기본 "*" (모든 오리진)
CORS_ORIGINS=*

# 등록 가능한 IP 카메라 최대 대수 (1~64, 기본 16). 초과 시 POST 409
MAX_IPCAMS=16

# mediamtx API 주소. Docker 는 compose environment 가 http://mediamtx:9997 주입,
# 로컬 실행 시 여기에 설정 (예: http://localhost:10001). 미설정이면 path 등록 실패.
MEDIAMTX_API=

# WebRTC 외부접속 광고 호스트 (공인 IP/도메인). webrtcAdditionalHosts 로 쓰임.
# 미설정이면 외부에서 영상이 안 나올 수 있음 (컨테이너 배포 #1 gotcha).
MEDIAMTX_WEBRTC_HOST=

# tracker 기본값. concept prompt 는 UI가 아닌 env 전용 설정이다.
TRACKER_DEFAULT=sam3
TRACKER_CONCEPT_PROMPT=person
TRACK_CONFIRM_FRAMES=3
TRACKER_CHECKPOINT=facebook/sam3
# gated checkpoint 접근 토큰. 비어 있으면 tracker child가 명시 오류로 종료한다.
HF_TOKEN=
TRACKER_INPUT_SIZE=560
TRACKER_FP16=true
TRACKER_MEMORY_BANK_SIZE=7
TRACKER_RECONDITION_EVERY_NTH_FRAME=16
TRACKER_MAX_VISION_FEATURES_CACHE_SIZE=1
# first-seen crop 저장소(빈값=process 임시 디렉토리)와 항목/JPEG 상한.
TRACK_GALLERY_DIR=
TRACK_GALLERY_MAX_ITEMS=500

# 로그 레벨 (기본 INFO)
LOG_LEVEL=
