PORT_OFFSET=
BACKEND_PORT=
FRONTEND_PORT=
MAX_IPCAMS=16

# mediamtx → 이 모듈 compose 의 bundled 인스턴스.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
MEDIAMTX_WEBRTC_HOST=
MEDIAMTX_BACKEND_USER=backend
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_tracking
MEDIAMTX_VIEWER_PASS=

# tracker registry + gated Hugging Face checkpoint (weights are not bundled).
# 누락 의존성은 requirements.txt 로만 관리하고 Ultralytics 자동 pip 설치는 금지한다.
YOLO_AUTOINSTALL=false
TRACKER_DEFAULT=sam3
TRACKER_CONCEPT_PROMPT=person
TRACK_CONFIRM_FRAMES=3
TRACKER_CHECKPOINT=facebook/sam3
HF_TOKEN=
# RTX 3090 보수 기본값. 해상도는 session 수명 동안 고정된다.
TRACKER_INPUT_SIZE=560
TRACKER_FP16=true
TRACKER_MEMORY_BANK_SIZE=7
TRACKER_RECONDITION_EVERY_NTH_FRAME=16
TRACKER_MAX_VISION_FEATURES_CACHE_SIZE=1
# process-local first-seen crop gallery. 빈 DIR은 안전한 임시 디렉토리를 쓴다.
TRACK_GALLERY_DIR=
TRACK_GALLERY_MAX_ITEMS=500
